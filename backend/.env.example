NAVER_NEWS_ID=
NAVER_NEWS_SECRET=
G2B_API_KEY=
NAVER_CLIENT_ID=
HIRA_API_KEY=

# Cloudflare R2 자료실 (미사용, NCP Object Storage 이관 예정)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# AI 어시스턴트 (Claude) — console.anthropic.com 에서 발급한 키 입력
ANTHROPIC_API_KEY=

# 구글 캘린더 양방향 연동 — console.cloud.google.com 에서 OAuth 클라이언트(웹 애플리케이션) 발급 후 입력
# 승인된 리디렉션 URI에 GOOGLE_REDIRECT_URI 값을 그대로 등록해야 함
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/api/google-calendar/callback
FRONTEND_URL=http://localhost:3000

# 배포 하드닝 — 프로덕션 도메인이 정해지면 값 교체
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# 최초 배포 시 관리자 계정 자동 생성용 (이미 송림 직원 계정이 있으면 무시됨) — seed_production.py
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=관리자
