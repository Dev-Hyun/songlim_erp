NAVER_NEWS_ID=
NAVER_NEWS_SECRET=
G2B_API_KEY=
NAVER_CLIENT_ID=
HIRA_API_KEY=

# 네이버 지도(NCP Maps) — 프론트 지도 스크립트가 실제로 읽는 건 NEXT_PUBLIC_NAVER_CLIENT_ID이고,
# 이건 backend/.env가 아니라 저장소 루트의 .env(docker-compose build arg)에 넣어야 함.
# 여기 NAVER_MAPS_CLIENT_SECRET은 서버사이드 지오코딩 등에 쓸 일이 생기면 사용 — 현재는 어떤
# 코드에서도 참조하지 않는 보관용 값.
NAVER_MAPS_CLIENT_SECRET=

# Cloudflare R2 자료실 (미사용, NCP Object Storage 이관 예정)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# AI 어시스턴트 (Claude) — console.anthropic.com 에서 발급한 키 입력
ANTHROPIC_API_KEY=

# 구글 캘린더 양방향 연동 — console.cloud.google.com 에서 OAuth 클라이언트(웹 애플리케이션) 발급 후 입력
# 승인된 리디렉션 URI에 GOOGLE_REDIRECT_URI 값을 그대로 등록해야 함
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/api/google-calendar/callback
FRONTEND_URL=http://localhost:3000

# 배포 하드닝 — 프로덕션 도메인이 정해지면 값 교체
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# 최초 배포 시 관리자 계정 자동 생성용 (이미 송림 직원 계정이 있으면 무시됨) — seed_production.py
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=관리자
